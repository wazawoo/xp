{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xp",
  "type": "object",
  "properties": {
    "education": {
      "description": "Education started/completed by the person",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Education"
      }
    },
    "links": {
      "description": "Links related to the person",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Link"
      }
    },
    "personal_info": {
      "description": "Identifiable information for the person",
      "$ref": "#/$defs/PersonalInfo"
    },
    "skill_categories": {
      "description": "Categories of skills possessed by the person",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillCategory"
      }
    },
    "work": {
      "description": "Work experience started/completed by the person",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Work"
      }
    }
  },
  "required": [
    "personal_info",
    "links",
    "work",
    "education",
    "skill_categories"
  ],
  "$defs": {
    "Education": {
      "type": "object",
      "properties": {
        "degree": {
          "description": "Name of started/completed degree",
          "type": [
            "string",
            "null"
          ]
        },
        "end_date": {
          "description": "End date (format unspecified to allow \"Present\", for example)",
          "type": [
            "string",
            "null"
          ]
        },
        "gpa": {
          "description": "Grade point average (format unspecified to allow for GPA variants, adjustable decimal precision, etc.)",
          "type": [
            "string",
            "null"
          ]
        },
        "institution_name": {
          "description": "Name of educational institution",
          "type": [
            "string",
            "null"
          ]
        },
        "majors": {
          "description": "List of started/completed majors",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Major"
          }
        },
        "minors": {
          "description": "List of started/completed minors",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Minor"
          }
        },
        "start_date": {
          "description": "Start date (format unspecified to allow \"2010\", \"May 1995\", etc.)",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Link": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Identifier, potentially unique",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Title for display or alt-text",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Web url (format unspecified)",
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "Major": {
      "type": "object",
      "properties": {
        "gpa": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "Minor": {
      "type": "object",
      "properties": {
        "gpa": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "PersonalInfo": {
      "type": "object",
      "properties": {
        "email": {
          "description": "Email address (format unspecified)",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Name (format unspecified)",
          "type": "string"
        },
        "phone_number": {
          "description": "Phone number (format unspecified)",
          "type": [
            "string",
            "null"
          ]
        },
        "physical_location": {
          "description": "Physical location, if applicable",
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "description": "Personal website url (format unspecified)",
          "type": [
            "string",
            "null"
          ]
        },
        "work_location_preference": {
          "description": "Work location preference, if applicable",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "SkillCategory": {
      "type": "object",
      "properties": {
        "category": {
          "description": "Title of skill category",
          "type": "string"
        },
        "include": {
          "description": "Whether to include skill category (useful for modular resumes)",
          "type": "boolean"
        },
        "skills": {
          "description": "List of skills in this category",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "category",
        "include",
        "skills"
      ]
    },
    "Work": {
      "type": "object",
      "properties": {
        "bullets": {
          "description": "Individual items describing nature of started/completed work",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "company_name": {
          "description": "Company name",
          "type": [
            "string",
            "null"
          ]
        },
        "end_date": {
          "description": "End date (format unspecified to allow \"Present\", for example)",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Identifier, potentially unique",
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "description": "Title of started/completed work position",
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "description": "Start date (format unspecified to allow \"2010\", \"May 1995\", etc.)",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}